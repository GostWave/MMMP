<?xml version="1.0" ?>
<robot name="four_tables_circle">

  <link name="world" />

<!--Стол №1-->
  <link name="table_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.2 0.75 0.05"/></geometry>
      <material name="wood"><color rgba="0.6 0.4 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.2 0.75 0.05"/></geometry>
    </collision>
    <visual> <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <geometry><box size="1.0 0.5 0.7"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.0 0.5 0.7"/></geometry>
    </collision>
  </link>

  <joint name="joint_table_1" type="fixed">
    <parent link="world"/>
    <child link="table_1"/>
    <origin xyz="0.8 0 0" rpy="0 0 1.57"/>
  </joint>

<!--Стол №2-->
