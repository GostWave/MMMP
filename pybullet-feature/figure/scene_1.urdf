<!-- Микроволновка на столе №1 -->
 <link name="microwave_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/> <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="microwave.stl" scale="0.0009 0.0009 0.0009"/>
        </geometry>
        <material name="gray">
            <color rgba="0.3 0.3 0.3 1.0" />
        </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="microwave.stl" scale="0.0009 0.0009 0.0009"/>
      </geometry>
    </collision>
</link>

  <joint name="joint_micro_1" type="fixed">
    <parent link="table_1"/>
    <child link="microwave_1"/>
    <origin xyz="0 0 0.75" rpy="0 0 0"/>
 </joint> 

