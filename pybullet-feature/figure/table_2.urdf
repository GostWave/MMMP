<?xml version="1.0" ?>
<robot name="table_zone_2">
  <link name="table_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.2 0.75 0.05"/></geometry>
      <material name="wood"><color rgba="0.6 0.4 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.2 0.75 0.05"/></geometry>
    </collision>
    <visual> <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <geometry><box size="1.0 0.5 0.7"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.0 0.5 0.7"/></geometry>
    </collision>
  </link>

   <link name="oven">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/> <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="oven_open.stl" scale="0.0009 0.0009 0.0009"/>
        </geometry>
        <material name="gray">
            <color rgba="0.3 0.3 0.3 1.0" />
        </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="oven_open.stl" scale="0.0009 0.0009 0.0009"/>
      </geometry>
    </collision>
  </link>

  <link name="grill">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/> <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <mesh filename="grill_open.stl" scale="0.0009 0.0009 0.0009"/>
        </geometry>
        <material name="gray">
            <color rgba="0.3 0.3 0.3 1.0" />
        </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="grill_open.stl" scale="0.0009 0.0009 0.0009"/>
      </geometry>
    </collision>
  </link>

  <joint name="j_oven" type="fixed">
    <parent link="table_2"/><child link="oven"/>
    <origin xyz="0.25 0 0.75" rpy="0 0 3.14"/>
  </joint>

  <joint name="j_grill" type="fixed">
    <parent link="table_2"/><child link="grill"/>
    <origin xyz="-0.25 -0.2 0.75" rpy="0 0 0"/>
  </joint>
</robot>